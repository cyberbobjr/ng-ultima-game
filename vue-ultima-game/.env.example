# Backend API Configuration
# Copy this file to .env and configure as needed

# Development with FastAPI backend (recommended for real assets)
VITE_API_BASE_URL=http://localhost:8000

# Production with deployed backend
# VITE_API_BASE_URL=https://your-api.example.com

# Fallback mode (no backend needed, uses generated tiles/maps)
# VITE_API_BASE_URL=

# Note: After changing .env, restart the dev server (npm run dev)
